# Copy to .env and fill in. Every key is optional: a missing key makes its source
# report `skipped_no_credentials` and the run still completes.
# NEVER commit .env. It is gitignored; the pre-commit gitleaks hook also blocks it.

# --- X ---
# X_PROVIDER=web_session (default): your own x.com account in a local browser. Log in once
# from the GUI Settings page (a browser window opens; you log in yourself), or paste the
# auth_token and ct0 cookies below. Session is stored in ~/.socmint/sessions/, never here.
X_PROVIDER=web_session
X_AUTH_TOKEN=
X_CT0=
# Runs use a hidden browser (true, default). Set false to watch the window, e.g. if X
# shows an account challenge. The Settings login window is always visible.
X_BROWSER_HEADLESS=true
X_MAX_SCROLLS=40
# X_PROVIDER=twitterapi_io: TwitterAPI.io provider API
TWITTERAPI_IO_KEY=
# X_PROVIDER=official: official X API v2 recent search (7-day coverage)
X_BEARER_TOKEN=

# --- Telegram (Telethon user session) ---
# api_id / api_hash from https://my.telegram.org. First run prompts for the login code.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=socmint.session
# Premium account enables global post search (channels.searchPosts). Without it the
# module falls back to a seed channel list + per-channel date-bounded search.
TELEGRAM_HAS_PREMIUM=false

# --- YouTube Data API v3 ---
YOUTUBE_API_KEY=

# --- LinkedIn Ads (public Ad Library; owner module adapter) ---
# No login required for the public Ad Library.

# --- LinkedIn posts (owner decision 2026-11-19: your own logged-in linkedin.com session) ---
# Paste the Cookie header of a logged-in linkedin.com tab (or li_at alone). LinkedIn
# restricts accounts that automate searches; collection is paced and stops at any checkpoint.
LINKEDIN_COOKIE=
LINKEDIN_MAX_SCROLLS=25
LINKEDIN_BROWSER_HEADLESS=true
# browser (default) | voyager (direct Voyager search API calls with the same session;
# needs li_at and JSESSIONID in LINKEDIN_COOKIE). LINKEDIN_MAX_SCROLLS caps voyager pages.
LINKEDIN_PROVIDER=browser
# Rotates with LinkedIn deploys: copy the current one from DevTools > Network on HTTP 400/404.
LINKEDIN_VOYAGER_QUERY_ID=voyagerSearchDashClusters.5ba32757c00b31aea747c8bebb92855c
# Leave empty for the built-in desktop Chrome string, or paste your own browser's.
LINKEDIN_USER_AGENT=

# --- Analysis LLM (narrative labels, claim extraction, stance) ---
# Missing key => keyword-only narrative labels and no LLM claim steps; run still completes.
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-haiku-4-5

# --- Misinformation evidence ---
GOOGLE_FACTCHECK_API_KEY=
# SerpApi for news/evidence lookups (optional)
SERPAPI_KEY=
# serper.dev (a different service; 40-character key) for news/evidence lookups (optional)
SERPER_API_KEY=

# --- Run controls ---
MAX_WINDOW_DAYS=30
# 0 = no time limit (stop a long run from the progress page)
RUN_TIME_BUDGET_SECONDS=0
