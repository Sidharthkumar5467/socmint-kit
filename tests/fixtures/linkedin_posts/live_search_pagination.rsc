questMetadata"}}, "isApfcEnabled": false, "isStreaming": false, "rumPageKey": "", "maxRetries": 0, "backOffMultiplier": 0, "maxSeconds": 0}}], "tracking": {"$type": "proto.sdui.components.core.ActionTrackingAnnotations", "breadcrumbs": [], "actionType": "expandControl"}, "actionLabel": "View more options"}, "viewTrackingSpecs": "$36:props:children:props:viewTrackingSpecs"}], "viewTrackingSpecs": "$36:props:children:props:viewTrackingSpecs"}]}]}]
37:["$", "$e", "2", {"children": ["$", "$La", null, {"componentKey": "70dd2137-d188-46b8-bae5-63d5fa29b70a", "viewTrackingSpecs": {"viewName": "feed-commentary"}, "children": ["$", "$L5c", null, {"textProps": {"fontFamily": "sans", "fontSize": "small", "fontStyle": "normal", "fontWeight": "normal", "lineHeight": "custom", "textAlign": "start", "children": [[["$", "$e", "0", {"children": [null, "Jamaica's reconstruction authority is entering its decisive phase - and the money question is now about rules, not announcements."]}], ["$", "$e", "1", {"children": [["$", "br", null, {}], ""]}], ["$", "$e", "2", {"children": [["$", "br", null, {}], "The National Reconstruction and Resilience Authority (NaRRA) regulations may now have been tabled in Parliament, according to the Jamaica Observer today. That matters because how the regulations align with the conditions attached to multilateral financing will decide how much of the over-US$6 billion promised after Hurricane Melissa Jamaica can actually access."]}], ["$", "$e", "3", {"children": [["$", "br", null, {}], ""]}], ["$", "$e", "4", {"children": [["$", "br", null, {}], "Only US$400 million of that money - from CAF, the Development Bank of Latin America and the Caribbean - has been budgeted this fiscal year, and it requires the Jamaican Government to send its cash subscription to the bank first. The balance, mainly from the Inter-American Development Bank and the World Bank, carries the usual, more onerous conditionalities."]}], ["$", "$e", "5", {"children": [["$", "br", null, {}], ""]}], ["$", "$e", "6", {"children": [["$", "br", null, {}], "Oversight sits with the Jamaica Reconstruction and Resilience Oversight Committee (JAMRROC), chaired by economist Peter Blair Henry, which is to report publicly on NaRRA's work from early 2027. NaRRA's remit is reconstruction and resilience - large-scale infrastructure, not relief: relief money does not fund NaRRA, and NaRRA funds cannot be reassigned to relief."]}], ["$", "$e", "7", {"children": [["$", "br", null, {}], ""]}], ["$", "$e", "8", {"children": [["$", "br", null, {}], "For anyone building, investing or relocating in Jamaica, the practical read: the rebuild's pace will be set by regulation, procurement and oversight, not by the size of the headline figure. Watch the regulations, and watch what JAMRROC reports."]}], ["$", "$e", "9", {"children": [["$", "br", null, {}], ""]}], ["$", "$e", "10", {"children": [["$", "br", null, {}], "Source: Jamaica Observer, 19 November 2026."]}]]], "componentkey": "70dd2137-d188-46b8-bae5-63d5fa29b70a", "insetTop": "0.5x", "insetBottom": "0.5x", "insetStart": "1.5x", "insetEnd": "1.5x", "linkHoverDecoration": "none", "lineClamp": 3, "hasShowMore": false, "expandButtonText": "more", "shouldCollapseNewLines": false, "noopOverride": false}, "bindingKey": {"key": {"value": {"$case": "id", "id": "expandable_text_block_auto-component-f38c8fbe-4179-46dc-895c-3153c972ce81"}}, "namespace": ""}, "expandButtonTextColorExpression": 179, "maxLineCountExpression": 3, "onShowMoreAction": {"actions": [null], "tracking": {"$type": "proto.sdui.components.core.ActionTrackingAnnotations", "breadcrumbs": [], "actionType": "expandCommentaryText"}}, "onShowLessAction": "$undefined", "viewTrackingSpecs": "$37:props:children:props:viewTrackingSpecs"}]}]}]
