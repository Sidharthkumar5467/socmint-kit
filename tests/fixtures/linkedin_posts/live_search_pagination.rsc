26:["$", "$e", "2", {"children": ["$", "$La", null, {"componentKey": "eaa63dd0-1abc-404f-a413-940b5d4aded7", "viewTrackingSpecs": {"viewName": "feed-commentary"}, "children": ["$", "$L5c", null, {"textProps": {"fontFamily": "sans", "fontSize": "small", "fontStyle": "normal", "fontWeight": "normal", "lineHeight": "custom", "textAlign": "start", "children": [["$", "$e", "text-attr-0", {"children": [[null, [["$", "$e", "0", {"children": [null, "Nobody puts this on LinkedIn, so I will."]}], ["$", "$e", "1", {"children": [["$", "br", null, {}], "⠀"]}], ["$", "$e", "2", {"children": [["$", "br", null, {}], "It is hard to make a living as a freelance lawyer."]}], ["$", "$e", "3", {"children": [["$", "br", null, {}], "⠀"]}], ["$", "$e", "4", {"children": [["$", "br", null, {}], "After 13 years at Bank of America Merrill Lynch, I went independent in 2015."]}], ["$", "$e", "5", {"children": [["$", "br", null, {}], "⠀"]}], ["$", "$e", "6", {"children": [["$", "br", null, {}], "I pictured a steady stream of interesting clients who needed a derivatives expert."]}], ["$", "$e", "7", {"children": [["$", "br", null, {}], "⠀"]}], ["$", "$e", "8", {"children": [["$", "br", null, {}], "Here is what it actually looked like."]}], ["$", "$e", "9", {"children": [["$", "br", null, {}], "⠀"]}], ["$", "$e", "10", {"children": [["$", "br", null, {}], "Projects that lasted a week."]}], ["$", "$e", "11", {"children": [["$", "br", null, {}], "Projects that lasted two months."]}], ["$", "$e", "12", {"children": [["$", "br", null, {}], "A recruiter who told me a big bank project desperately needed my expertise. I signed on. It turned out they did not need me much at all."]}], ["$", "$e", "13", {"children": [["$", "br", null, {}], "Engagements that started with a handshake and then went quiet."]}], ["$", "$e", "14", {"children": [["$", "br", null, {}], "⠀"]}], ["$", "$e", "15", {"children": [["$", "br", null, {}], "Feast."]}], ["$", "$e", "16", {"children": [["$", "br", null, {}], "Famine."]}], ["$", "$e", "17", {"children": [["$", "br", null, {}], "Mostly famine."]}], ["$", "$e", "18", {"children": [["$", "br", null, {}], "⠀"]}], ["$", "$e", "19", {"children": [["$", "br", null, {}], "I am not writing this to complain."]}], ["$", "$e", "20", {"children": [["$", "br", null, {}], "⠀"]}], ["$", "$e", "21", {"children": [["$", "br", null, {}], "Those years taught me things I could not have learned inside a big institution."]}], ["$", "$e", "22", {"children": [["$", "br", null, {}], "⠀"]}], ["$", "$e", "23", {"children": [["$", "br", null, {}], "How to walk into an unfamiliar organization and figure out quickly what the business actually needs."]}], ["$", "$e", "24", {"children": [["$", "br", null, {}], "How to be useful without a team behind me."]}], ["$", "$e", "25", {"children": [["$", "br", null, {}], "How to explain complicated derivatives rules to people who had never touched a swap."]}], ["$", "$e", "26", {"children": [["$", "br", null, {}], "⠀"]}], ["$", "$e", "27", {"children": [["$", "br", null, {}], "On one project, I was the subject matter expert on new swap margin rules for a global bank, guiding negotiators who had almost no derivatives experience. That project taught me more about teaching than any job title ever did."]}], ["$", "$e", "28", {"children": [["$", "br", null, {}], "⠀"]}], ["$", "$e", "29", {"children": [["$", "br", null, {}], "Those years also taught me something about myself."]}], ["$", "$e", "30", {"children": [["$", "br", null, {}], "⠀"]}], ["$", "$e", "31", {"children": [["$", "br", null, {}], "I do my best work inside a team."]}], ["$", "$e", "32", {"children": [["$", "br", null, {}], "With structure."]}], ["$", "$e", "33", {"children": [["$", "br", null, {}], "With a mission bigger than the next engagement."]}], ["$", "$e", "34", {"children": [["$", "br", null, {}], "⠀"]}], ["$", "$e", "35", {"children": [["$", "br", null, {}], "The best stretch of my recent career was helping launch the FMX Futures Exchange at Cantor Fitzgerald, surrounded by people who wanted the same outcome I did."]}], ["$", "$e", "36", {"children": [["$", "br", null, {}], "⠀"]}], ["$", "$e", "37", {"children": [["$", "br", null, {}], "That is what I am building toward next."]}], ["$", "$e", "38", {"children": [["$", "br", null, {}], "⠀"]}], ["$", "$e", "39", {"children": [["$", "br", null, {}], "To everyone out there consulting, freelancing, or \"between things\": you are not alone, and the skills you are building count."]}], ["$", "$e", "40", {"children": [["$", "br", null, {}], "⠀"]}], ["$", "$e", "41", {"children": [["$", "br", null, {}], "Have you lived the consultant feast or famine? What did it teach you?"]}], ["$", "$e", "42", {"children": [["$", "br", null, {}], "⠀"]}]], [["$", "br", "0", {}]]], ["$", "span", null, {"children": [["$", "$L5e", "text-attr-0", {"action": {"actions": [{"$type": "proto.sdui.actions.core.Navigate", "value": {"content": {"$case": "url", "url": {"$type": "proto.sdui.actions.core.NavigateToUrl", "openInNewTab": false, "interop": false, "clearBackStack": false, "urlValue": {"$case": "url", "url": "https://www.linkedin.com/search/results/all/?keywords=%23consulting&origin=HASH_TAG_FROM_FEED"}}}}}], "tracking": {"$type": "proto.sdui.components.core.ActionTrackingAnnotations", "breadcrumbs": [], "actionType": "viewHashtagFeed"}, "actionLabel": "View hashtag: #consulting"}, "viewTrackingSpecs": {"viewName": "feed-commentary"}, "linkStyle": {"$type": "proto.sdui.components.core.text.LinkStyle", "shouldSupportVisitedState": false, "linkFormatting": "LinkFormatting_NONE"}, "children": ["$L5f"]}]]}], "$L60"]}], "$L61", "$L62"], "componentkey": "eaa63dd0-1abc-404f-a413-940b5d4aded7", "insetTop": "0.5x", "insetBottom": "1x", "insetStart": "1.5x", "insetEnd": "1.5x", "linkHoverDecoration": "none", "lineClamp": 3, "hasShowMore": false, "expandButtonText": "more", "shouldCollapseNewLines": false, "noopOverride": false}, "bindingKey": {"key": {"value": {"$case": "id", "id": "expandable_text_block_auto